# Reminder: anything exposed through a Vite client-side variable (any name
# prefixed VITE_) is bundled into the JavaScript shipped to every visitor's
# browser. It is PUBLIC, not a secret, no matter how it's named.
#
# Real secrets (API keys, database URLs, JWT signing secrets, third-party
# service credentials, etc.) must live on the backend (see backend/.env.example),
# never in this file, never with a VITE_ prefix, and never committed to git.
# See SECURITY.md for details.

# Base URL of the Velnora backend API. Leave unset — src/lib/api.ts
# defaults to a same-origin relative "/api" path, proxied to the local
# backend by vite.config.ts's dev-server proxy, and to the deployed
# Render backend by vercel.json's rewrite in production. Only set this
# to override that (e.g. pointing local dev at a remote staging backend
# directly instead of the local one) — an absolute cross-origin URL here
# broke the Admin Dashboard's session cookie twice in production
# (browsers won't attach SameSite=Lax to a cross-site request, and
# SameSite=None then hit third-party-cookie blocking), which is why the
# same-origin proxy is the default instead.
VITE_API_URL=
