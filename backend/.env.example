# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Prisma format).
DATABASE_URL="postgresql://velnora_app:CHANGE_ME@localhost:5432/velnora?schema=public"

# Port the API server listens on.
PORT=4000

NODE_ENV=development

# Comma-separated list of origins allowed to call this API (CORS).
# In production, set this to the real deployed frontend origin(s) only,
# never "*".
FRONTEND_URL=http://localhost:5173

# Reserved for Phase 3 (authentication). Not read by any code yet, but the
# variable is documented here so it's never improvised as a frontend
# VITE_* value later. Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Rate limiting for public form endpoints (POST /api/contact,
# POST /api/project-inquiry). Window in milliseconds, max requests per
# window per IP.
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# --- AI Client Handling Agent (Phase 3) ---
# Server-only. NEVER expose this to the frontend (no VITE_* equivalent
# exists and none should ever be added). Leave unset to run the rest of
# the API without AI: POST /api/ai/chat will return a friendly "not
# configured" error instead of the whole server failing to start.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model id, effort level, and output cap for the AI consultant. Low
# effort is deliberate for a concise, latency-sensitive chat reply, not a
# reasoning-heavy task, see backend/README.md's AI Agent section.
AI_MODEL=claude-opus-5
AI_EFFORT=low
AI_MAX_TOKENS=1024

# Rate limiting for POST /api/ai/chat specifically (tighter than the form
# endpoints above, since every request costs real money against the AI
# provider). Window in milliseconds, max requests per window per IP.
AI_CHAT_RATE_LIMIT_WINDOW_MS=60000
AI_CHAT_RATE_LIMIT_MAX=10

# Hard cap on messages per conversation, after which the agent stops
# calling the AI provider and points the visitor to the contact form
# instead. Bounds the cost/abuse surface of a single chat session.
AI_MAX_MESSAGES_PER_CONVERSATION=40

# --- AI Lead Finder Agent (Phase 4) ---
# Legacy shared secret accepted on every /api/leads/* request (header
# X-Admin-Token), kept working alongside the newer Admin Dashboard login
# session for backward compatibility (see requireAdminAccess.ts) — the
# standalone /internal/lead-finder test page still uses it. Every route
# is closed by default: leave this unset (and don't log in as an admin
# either) and every /api/leads/* request gets a 401, never an
# open/public endpoint. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_FINDER_ADMIN_TOKEN=

# Google Places API (New) key, used for business discovery ("dentists in
# Lahore"). Optional — leave unset and POST /api/leads/search returns a
# clear "not configured" error instead of the server failing to start.
# Get one at https://console.cloud.google.com/apis/credentials (enable
# "Places API (New)"). Restrict the key to that API in the Cloud Console.
GOOGLE_PLACES_API_KEY=

# Rate limiting for the expensive Lead Finder endpoints (search, analyze,
# generate-email, create-draft) — each one costs real money against
# Google Places and/or the AI provider. Window in ms, max requests per
# window per caller.
LEAD_FINDER_RATE_LIMIT_WINDOW_MS=60000
LEAD_FINDER_RATE_LIMIT_MAX=5

# Reasoning effort for outreach email generation (reuses ANTHROPIC_API_KEY
# and AI_MODEL above, see "AI Lead Finder Agent" in backend/README.md).
# "medium" since email copywriting benefits from more care than a quick
# chat reply.
LEAD_EMAIL_AI_EFFORT=medium

# Gmail OAuth — DRAFT CREATION ONLY, this codebase never calls Gmail's
# send endpoint. Create an OAuth 2.0 Client (type "Web application") in
# Google Cloud Console, add GOOGLE_REDIRECT_URI as an authorized redirect
# URI, then visit GET /api/leads/gmail/auth-url once (with your
# LEAD_FINDER_ADMIN_TOKEN) to get GOOGLE_REFRESH_TOKEN — see
# backend/README.md's "Gmail OAuth setup" for the full one-time flow.
# Leave any of these unset and POST /api/leads/:id/create-draft returns a
# clear "Gmail not configured" error rather than failing silently.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/leads/gmail/oauth-callback
GOOGLE_REFRESH_TOKEN=

# --- Admin Dashboard authentication ---
# Both optional. If set, and no AdminUser row already exists with this
# email, the server creates the first admin account from these values
# once at startup, hashing ADMIN_PASSWORD with bcrypt immediately — the
# plaintext value is never stored, logged, or returned by any endpoint,
# and this never overwrites an existing account's password on a later
# restart. Leave both unset once the account exists; there's no need to
# keep a real password sitting in this file long-term. Never commit a
# real value here (this file only, .env itself is gitignored).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# How long a logged-in admin session cookie stays valid (milliseconds).
ADMIN_SESSION_TTL_MS=43200000

# Rate limiting for POST /api/auth/admin/login (brute-force defense).
# Window in ms, max attempts per window per IP.
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX=5

# --- AI Assistant (Admin Dashboard voice console) ---
# Text commands (POST /api/admin/ai-assistant/command) reuse
# ANTHROPIC_API_KEY above and need nothing extra. ELEVENLABS_API_KEY is
# for voice OUTPUT only (POST /api/admin/ai-assistant/speak) — leave it
# unset and that one endpoint returns a clear "voice output not
# configured" error while text commands keep working normally. Get a key
# at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Which ElevenLabs voice to speak replies in. Default is ElevenLabs'
# public "Rachel" voice, available on every account with no extra setup.
# Browse alternatives at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Rate limiting for the AI Assistant endpoints (each command costs real
# money against the AI provider, and each spoken reply against
# ElevenLabs). Window in ms, max requests per window per IP.
AI_ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
AI_ASSISTANT_RATE_LIMIT_MAX=15
