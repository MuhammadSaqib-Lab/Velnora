// Velnora backend database schema.
//
// Design notes:
// - `projectType` / `budgetRange` are plain strings, not Prisma enums.
//   `projectType` is a fixed dropdown (UI copy owned by the frontend,
//   src/sections/Contact.tsx, validated against an enum at the API
//   boundary — see src/validators). `budgetRange` was a fixed dropdown too
//   until it was deliberately replaced with an open-ended free-text field
//   (a new agency showing preset pricing tiers before a conversation even
//   starts was scaring off potential clients) — it only has a length cap
//   now (see shared.ts's optionalBudgetSchema), never a fixed value set.
//   Both stay plain strings either way: a DB enum would need a migration
//   every time this "content" changes, and that's the wrong layer for it.
// - `SubmissionStatus` (internal triage state) and `LeadStatus` (a
//   different lifecycle for the future lead-finder feature) ARE enums,
//   because those values are genuinely fixed and owned by us, not by
//   frontend copy.
// - `repoLink` on ProjectInquiry isn't in the original Phase 2 spec, it
//   was added because the existing Contact form already collects it
//   (see FileHandover.tsx) and dropping it silently would lose real user
//   input. File attachments themselves are still not persisted anywhere,
//   real storage (e.g. S3 + a presigned upload flow) is a future phase.
// - Phase 3 adds AIConversation/AIMessage/QualifiedLead for the AI Client
//   Handling Agent (see backend/src/ai/). QualifiedLead reuses
//   `SubmissionStatus` for triage, matching ContactSubmission/
//   ProjectInquiry's vocabulary instead of inventing a fourth
//   near-duplicate enum. It is intentionally a separate model from the
//   `Lead` model below — a lead the AI consultant captures mid-conversation
//   is a different lifecycle from a business the lead-finder discovers
//   unprompted.
// - Phase 4 (see backend/src/leadFinder/) extends the `Lead` model that
//   was previously pure schema preparation. `opportunityScore` is reused
//   as-is for the 0-100 score rather than adding a duplicate field.
//   `domain` (normalized hostname from `website`) backs deduplication and
//   carries a unique constraint — Postgres allows multiple NULLs in a
//   unique index, so leads with no website never collide on it.
//   `analysis`/`evidence` are structured JSON (research findings, per-
//   opportunity evidence) rather than free text, kept separate from the
//   existing `notes` field, which stays a simple human-editable note.
// - AdminUser/AdminSession (Admin Dashboard authentication) are
//   deliberately separate from the `User` model above rather than
//   reusing it: `User` is still untouched schema preparation for a future
//   general-purpose, multi-role auth system (Phase 3 proper), while
//   AdminUser is a narrow, single-purpose account type for the one
//   internal dashboard that exists today. Session tokens are never
//   stored raw — `AdminSession.tokenHash` holds a SHA-256 digest of the
//   random token the browser actually holds in its cookie, so a database
//   read alone can never hand out a usable session credential.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum LeadStatus {
  NEW
  RESEARCHED
  QUALIFIED
  EMAIL_DRAFTED
  CONTACTED
  REPLIED
  NOT_INTERESTED
  CONVERTED
  DISQUALIFIED
}

enum OpportunityType {
  NO_WEBSITE
  OLD_WEBSITE
  POOR_MOBILE
  WEAK_SEO
  AI_AUTOMATION
}

enum LeadPriority {
  EXCELLENT
  STRONG
  POTENTIAL
  LOW
}

enum ConversationStatus {
  ACTIVE
  QUALIFIED
  CLOSED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum LeadIntent {
  LOW
  MEDIUM
  HIGH
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Prepared for Phase 3 (authentication). Not used by any endpoint yet.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@map("users")
}

/// General "contact us" submissions. No public frontend form posts here
/// yet (the existing Contact form maps to ProjectInquiry, see above), but
/// the endpoint is fully implemented for a future, simpler contact touchpoint.
model ContactSubmission {
  id           String            @id @default(cuid())
  name         String
  email        String
  company      String?
  phone        String?
  projectType  String?
  budgetRange  String?
  message      String
  status       SubmissionStatus  @default(NEW)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

/// The site's main "Start a Project" form (src/sections/Contact.tsx).
model ProjectInquiry {
  id           String            @id @default(cuid())
  name         String
  email        String
  company      String?
  phone        String?
  projectType  String?
  budgetRange  String?
  message      String
  repoLink     String?
  status       SubmissionStatus  @default(NEW)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("project_inquiries")
}

/// Phase 4: AI Lead Finder Agent (backend/src/leadFinder/). Businesses
/// discovered via research, never fabricated — every field here either
/// comes from a real source (search provider, the business's own
/// website) or is left null/unknown. `email`/`phone` are only ever
/// populated from what was actually found; a lead with no verified email
/// simply never reaches EMAIL_DRAFTED status.
model Lead {
  id               String            @id @default(cuid())
  businessName     String
  category         String?
  website          String?
  domain           String?
  email            String?
  phone            String?
  location         String?
  source           String?
  sourceUrl        String?
  opportunityTypes OpportunityType[]
  opportunityScore Int?
  priority         LeadPriority?
  status           LeadStatus        @default(NEW)
  /// Structured research findings (design/mobile/SEO/AI-opportunity
  /// observations) — see backend/src/leadFinder/analysis/.
  analysis         Json?
  /// Per-opportunity evidence + source, shown alongside opportunityTypes.
  evidence         Json?
  emailSubject     String?
  emailBody        String?
  gmailDraftId     String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([domain])
  @@index([status])
  @@index([opportunityScore])
  @@index([priority])
  @@map("leads")
}

/// Phase 3: AI Client Handling Agent. One row per chat widget session.
/// `sessionId` is a server-minted UUID the frontend echoes back on each
/// message (kept in sessionStorage, not persistent across browser
/// restarts) — never trusted as a client-chosen identifier for a new row.
model AIConversation {
  id           String             @id @default(cuid())
  sessionId    String             @unique
  status       ConversationStatus @default(ACTIVE)
  visitorName  String?
  visitorEmail String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  messages     AIMessage[]
  lead         QualifiedLead?

  @@index([status])
  @@index([createdAt])
  @@map("ai_conversations")
}

/// Individual turns of an AIConversation. Only final user-visible text is
/// stored — intermediate tool_use/tool_result content from a mid-turn
/// tool call is never persisted, it's ephemeral to a single request.
model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// Admin Dashboard authentication. One row per operator account able to
/// log into /internal/admin. `passwordHash` is always a bcrypt hash,
/// never a plaintext or reversibly-encrypted password — see
/// backend/src/utils/passwordHash.ts and adminAuth.service.ts's
/// bootstrapInitialAdminUser (creates the first row from
/// ADMIN_EMAIL/ADMIN_PASSWORD, once, if no account exists yet).
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions     AdminSession[]

  @@map("admin_users")
}

/// A single logged-in browser session for an AdminUser, backing the
/// httpOnly session cookie (backend/src/services/adminAuth.service.ts).
/// `tokenHash` is a SHA-256 digest of the random token the cookie
/// actually carries — the raw token is never persisted anywhere.
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  userAgent   String?
  ipAddress   String?

  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// A lead the AI Consultant captured mid-conversation once qualified.
/// Only ever contains what the visitor voluntarily provided — the model
/// never fabricates these fields (validated server-side before this row
/// is written, see backend/src/ai/tools/saveLead.tool.ts).
model QualifiedLead {
  id             String           @id @default(cuid())
  conversationId String           @unique
  name           String
  email          String
  phone          String?
  company        String?
  website        String?
  service        String?
  requirements   String
  budget         String?
  timeline       String?
  intent         LeadIntent
  status         SubmissionStatus @default(NEW)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  conversation   AIConversation   @relation(fields: [conversationId], references: [id])

  @@index([intent])
  @@index([status])
  @@index([createdAt])
  @@map("qualified_leads")
}

/// Public-facing client reviews (the "What Our Clients Say" section).
/// `email` is optional per the submission form — kept for admin follow-up
/// only, never displayed publicly. A review is never shown on the public
/// site until an admin sets it to APPROVED (see review.service.ts);
/// `rating` (1-5) is validated at the API boundary (Zod), not a DB CHECK
/// constraint, matching this project's existing convention of keeping
/// domain-value validation in the Zod layer rather than the schema.
model Review {
  id         String       @id @default(cuid())
  name       String
  email      String?
  rating     Int
  reviewText String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
  @@index([status, createdAt])
  @@index([rating])
  @@map("reviews")
}
