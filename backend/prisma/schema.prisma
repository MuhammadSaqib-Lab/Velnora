// Velnora backend database schema.
//
// Design notes:
// - `projectType` / `budgetRange` are plain strings, not Prisma enums. The
//   underlying value set (e.g. "1k-2.5k", "not-sure") is UI copy owned by
//   the frontend (src/sections/Contact.tsx) and has already changed once
//   during this project. Making it a DB enum would require a migration
//   every time marketing tweaks a pricing tier label. Strict validation of
//   the allowed values happens at the API boundary (Zod, see
//   src/validators), which is the right layer for values that are really
//   "content" rather than fixed domain data.
// - `SubmissionStatus` (internal triage state) and `LeadStatus` (a
//   different lifecycle for the future lead-finder feature) ARE enums,
//   because those values are genuinely fixed and owned by us, not by
//   frontend copy.
// - `repoLink` on ProjectInquiry isn't in the original Phase 2 spec, it
//   was added because the existing Contact form already collects it
//   (see FileHandover.tsx) and dropping it silently would lose real user
//   input. File attachments themselves are still not persisted anywhere,
//   real storage (e.g. S3 + a presigned upload flow) is a future phase.
// - Phase 3 adds AIConversation/AIMessage/QualifiedLead for the AI Client
//   Handling Agent (see backend/src/ai/). QualifiedLead reuses
//   `SubmissionStatus` for triage, matching ContactSubmission/
//   ProjectInquiry's vocabulary instead of inventing a fourth
//   near-duplicate enum. It is intentionally a separate model from the
//   existing `Lead` model above, which stays reserved for the future
//   lead-finder agent (Phase 5, outbound prospecting) — a lead the AI
//   consultant captures mid-conversation is a different lifecycle from a
//   business the lead-finder discovers unprompted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum ConversationStatus {
  ACTIVE
  QUALIFIED
  CLOSED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum LeadIntent {
  LOW
  MEDIUM
  HIGH
}

/// Prepared for Phase 3 (authentication). Not used by any endpoint yet.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@map("users")
}

/// General "contact us" submissions. No public frontend form posts here
/// yet (the existing Contact form maps to ProjectInquiry, see above), but
/// the endpoint is fully implemented for a future, simpler contact touchpoint.
model ContactSubmission {
  id           String            @id @default(cuid())
  name         String
  email        String
  company      String?
  phone        String?
  projectType  String?
  budgetRange  String?
  message      String
  status       SubmissionStatus  @default(NEW)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

/// The site's main "Start a Project" form (src/sections/Contact.tsx).
model ProjectInquiry {
  id           String            @id @default(cuid())
  name         String
  email        String
  company      String?
  phone        String?
  projectType  String?
  budgetRange  String?
  message      String
  repoLink     String?
  status       SubmissionStatus  @default(NEW)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("project_inquiries")
}

/// Preparation only for a future lead-finder feature. No route/controller
/// in this phase reads or writes this model.
model Lead {
  id               String     @id @default(cuid())
  businessName     String
  website          String?
  email            String?
  phone            String?
  location         String?
  source           String?
  status           LeadStatus @default(NEW)
  opportunityScore Int?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@index([opportunityScore])
  @@map("leads")
}

/// Phase 3: AI Client Handling Agent. One row per chat widget session.
/// `sessionId` is a server-minted UUID the frontend echoes back on each
/// message (kept in sessionStorage, not persistent across browser
/// restarts) — never trusted as a client-chosen identifier for a new row.
model AIConversation {
  id           String             @id @default(cuid())
  sessionId    String             @unique
  status       ConversationStatus @default(ACTIVE)
  visitorName  String?
  visitorEmail String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  messages     AIMessage[]
  lead         QualifiedLead?

  @@index([status])
  @@index([createdAt])
  @@map("ai_conversations")
}

/// Individual turns of an AIConversation. Only final user-visible text is
/// stored — intermediate tool_use/tool_result content from a mid-turn
/// tool call is never persisted, it's ephemeral to a single request.
model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// A lead the AI Consultant captured mid-conversation once qualified.
/// Only ever contains what the visitor voluntarily provided — the model
/// never fabricates these fields (validated server-side before this row
/// is written, see backend/src/ai/tools/saveLead.tool.ts).
model QualifiedLead {
  id             String           @id @default(cuid())
  conversationId String           @unique
  name           String
  email          String
  phone          String?
  company        String?
  website        String?
  service        String?
  requirements   String
  budget         String?
  timeline       String?
  intent         LeadIntent
  status         SubmissionStatus @default(NEW)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  conversation   AIConversation   @relation(fields: [conversationId], references: [id])

  @@index([intent])
  @@index([status])
  @@index([createdAt])
  @@map("qualified_leads")
}
